# PagePilot Docker 环境变量示例。
# 首次部署请复制为 .env，然后填入自己的值：
#   cp .env.example .env
#
# 用于加密访问密码、屏幕授权等服务端敏感数据。
# 已上线环境：必须继续使用原来的值，否则旧的加密数据可能无法解密。
# 全新部署：必须生成一个新的固定值；生产环境未配置时服务不会启动。
# 生成示例：
#   openssl rand -base64 32
HOSTCTL_MASTER_KEY=

# 空数据库首次启动时必填，必须使用你自己的管理员凭据。
HOSTCTL_ADMIN_USERNAME=
HOSTCTL_ADMIN_PASSWORD=

# 应用链接默认使用路径模式。只有完成 wildcard DNS、TLS 证书和反向代理后，
# 才切换为 domain/dual；HOSTCTL_APP_DOMAIN_SUFFIX 只填写 pg.example.com，不要填写 *.pg.example.com。
# HOSTCTL_APP_URL_MODE=path
# HOSTCTL_APP_DOMAIN_SUFFIX=
# HOSTCTL_APP_URL_SCHEME=https
# HOSTCTL_APP_URL_PORT=

# 完整配置参考：docs/CONFIGURATION.md
# 泛域名/Nginx/Caddy：deploy/APP_URL_MODE.md
